=LAMBDA(
  pTeamMemberName,
  pColumnName,
  LET(
    _functionName,
    N(
      "fn_GetTeamMemberInfo"
    ),
    _comment,
    N(
      "Gets the team member information specified by column name for the team member specified by name."
    ),
    _lookup_value,
    pTeamMemberName,
    _lookup_array,
    fn_GetTeamMemberInfoCol(
      tbl_TeamMemberInfo[[#Headers],
      [Name]]
    ),
    _return_array,
    (
      fn_GetTeamMemberInfoCol(
        pColumnName
      )
    ),
    _if_not_found,
    c_NOT_FOUND_TEXT,
    _match_mode,
    0,
    _search_mode,
    1,
    _prelimResult,
    XLOOKUP(
      _lookup_value,
      _lookup_array,
      _return_array,
      _if_not_found,
      _match_mode,
      _search_mode
    ),
    _result,
    IFERROR(
      _prelimResult,
      c_NOT_FOUND_TEXT
    ),
    _result
  )
)