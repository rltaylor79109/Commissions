=LAMBDA(
  pTeamMemberName,
  LET(
    _functionName,
    N(
      "fn_GetTeamMemberBonusRate"
    ),
    _comment,
    N(
      "Gets the commission bonus rate for the team member specified by name. This typically is only applicable to admins or ISAs."
    ),
    _result,
    fn_GetTeamMemberInfo(
      pTeamMemberName,
      tbl_TeamMemberInfo[[#Headers],
      [Bonus Rate]]
    ),
    _result
  )
)
